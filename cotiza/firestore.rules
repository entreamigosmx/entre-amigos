rules_version = '2';
// Versión 3. Se publican desde la app (Ajustes > Publicar reglas ahora).
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function verified() { return signed() && request.auth.token.email_verified == true; }
    function admin() {
      return verified() && request.auth.token.email.lower() in ['jesusreynosoalfaro@gmail.com'];
    }
    function myRol() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol; }
    function team() {
      return admin() || (signed() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && myRol() == 'equipo');
    }
    // Administradora de una empresa con convenio: solo ve lo de su empresa.
    function emp() { return signed() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && myRol() == 'empresa'; }
    function miEmpresa() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('empresa', ''); }
    match /usuarios/{uid} {
      allow read: if admin() || (signed() && request.auth.uid == uid);
      allow create: if signed() && request.auth.uid == uid
        && (request.resource.data.rol == 'cliente' || (admin() && request.resource.data.rol == 'admin'));
      allow update: if admin() || (signed() && request.auth.uid == uid && request.resource.data.rol == resource.data.rol
        && request.resource.data.get('inversionista', false) == resource.data.get('inversionista', false)
        && request.resource.data.get('convenioOk', false) == resource.data.get('convenioOk', false));
      allow delete: if admin();
    }
    match /config/{d} {
      allow read: if team();
      allow write: if admin();
    }
    // Cómo funciona el convenio para empresas: solo lo ve quien tú autorizaste (usuarios.convenioOk).
    match /config/convenioInfo {
      allow read: if admin() || (signed() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('convenioOk', false) == true);
    }
    match /cotizaciones/{id} {
      allow get: if signed();
      allow list: if admin()
        || (team() && resource.data.por == request.auth.uid)
        || (signed() && resource.data.aceptadoPor == request.auth.uid);
      allow create: if team() && request.resource.data.por == request.auth.uid;
      allow update: if admin()
        || (team() && resource.data.por == request.auth.uid && resource.data.estado == 'borrador'
            && request.resource.data.por == request.auth.uid && request.resource.data.estado in ['borrador', 'cotizado'])
        || (verified() && resource.data.estado == 'cotizado'
            && request.resource.data.estado == 'aceptado'
            && request.resource.data.aceptadoPor == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'aceptadoPor', 'aceptadoEmail', 'aceptadoNombre', 'aceptadoEn']));
      allow delete: if admin()
        || (team() && resource.data.por == request.auth.uid && resource.data.estado == 'borrador');
    }
    match /expedientes/{uid}/archivos/{tipo} {
      allow read: if admin() || (signed() && request.auth.uid == uid);
      allow create, update: if (admin() || (signed() && request.auth.uid == uid && request.resource.data.estado == 'pendiente'))
        && request.resource.data.data.size() < 1000000;
      allow delete: if admin();
    }
    match /solicitudes/{id} {
      allow create: if request.resource.data.estado == 'nueva'
        && request.resource.data.keys().hasOnly(['nombre', 'telefono', 'monto', 'plazo', 'unidad', 'garantia', 'desc', 'valor', 'nota', 'fecha', 'origen', 'uid', 'email', 'estado', 'empresa', 'empresaNombre', 'nDocs'])
        && (request.resource.data.get('empresa', '') == '' || exists(/databases/$(database)/documents/empresas/$(request.resource.data.empresa)))
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
        && request.resource.data.monto is number && request.resource.data.monto > 0 && request.resource.data.monto < 100000000
        && request.resource.data.get('desc', '').size() <= 200 && request.resource.data.get('nota', '').size() <= 300
        && (request.resource.data.get('uid', '') == '' || (signed() && request.resource.data.uid == request.auth.uid));
      allow update: if admin()
        || (signed() && resource.data.get('uid', '') == '' && request.resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'email']));
      allow read, delete: if admin();
      allow read: if emp() && resource.data.get('empresa', '') != '' && resource.data.empresa == miEmpresa();
      // Documentos que sube el empleado con su solicitud del convenio.
      match /docs/{k} {
        allow create: if k in ['ine_f', 'ine_r', 'domicilio', 'nomina']
          && get(/databases/$(database)/documents/solicitudes/$(id)).data.estado == 'nueva'
          && request.resource.data.keys().hasOnly(['data']) && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
        allow read, delete: if admin();
        allow read: if emp() && get(/databases/$(database)/documents/solicitudes/$(id)).data.get('empresa', '') == miEmpresa();
      }
    }
    match /ventas/{id} {
      allow create: if request.resource.data.estado == 'nueva'
        && request.resource.data.keys().hasOnly(['marca', 'modelo', 'anio', 'km', 'precio', 'como', 'nombre', 'telefono', 'nFotos', 'fecha', 'estado'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
        && request.resource.data.marca is string && request.resource.data.marca.size() <= 40
        && request.resource.data.modelo is string && request.resource.data.modelo.size() <= 60
        && request.resource.data.nFotos is number && request.resource.data.nFotos <= 25;
      allow read, update, delete: if admin();
      match /fotos/{f} {
        allow create: if f.matches('^[0-9]{2}$') && int(f) < 25
          && exists(/databases/$(database)/documents/ventas/$(id))
          && get(/databases/$(database)/documents/ventas/$(id)).data.estado == 'nueva'
          && request.resource.data.keys().hasOnly(['slot', 'i', 'data'])
          && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
        allow read, delete: if admin();
      }
    }
    match /borrados/{email} {
      allow get, delete: if admin() || (signed() && request.auth.token.email != null && request.auth.token.email.lower() == email);
      allow create, update, list: if admin();
    }
    match /repartos/{id} {
      allow read, write: if admin();
    }
    match /entregas/{id} {
      allow read, write: if admin();
    }
    // Aportaciones y retiros de inversionistas: solo el administrador.
    match /inversiones/{id} {
      allow read, write: if admin();
    }
    // El inversionista avisa que te prestó dinero: solo crea su aviso (pendiente) y ve los suyos; el administrador decide.
    match /solinv/{id} {
      allow read: if admin() || (signed() && resource.data.uid == request.auth.uid);
      allow create: if signed() && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'monto', 'tasa', 'fecha', 'nota', 'estado', 'reg'])
        && request.resource.data.monto is number && request.resource.data.monto > 0 && request.resource.data.monto < 100000000
        && request.resource.data.tasa is number && request.resource.data.tasa > 0 && request.resource.data.tasa < 20
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
        && request.resource.data.get('nota', '').size() <= 200;
      allow update, delete: if admin();
    }
    // Comprobantes de pago de los clientes (foto de la transferencia).
    match /comprobantes/{id} {
      allow read, write: if admin();
      allow create: if team() && request.resource.data.por == request.auth.uid;
      // El cliente puede mandar el comprobante de su propio pago desde su app; queda "por revisar".
      allow create: if signed() && request.resource.data.por == request.auth.uid
        && request.resource.data.estado == 'por revisar'
        && get(/databases/$(database)/documents/prestamos/$(request.resource.data.pid)).data.clienteUid == request.auth.uid;
      allow read: if signed() && resource.data.por == request.auth.uid;
    }
    // Papelera: copia de lo que se borra (préstamos, pagos, cotizaciones) para poder recuperarlo.
    match /papelera/{id} {
      allow read, write: if admin();
      allow create: if team() && request.resource.data.por == request.auth.uid;
    }
    // Bitácora: quién cambió qué y cuándo. Solo el administrador la lee; nadie la puede editar ni borrar.
    match /bitacora/{id} {
      allow read, delete: if admin();
      allow create: if team() && request.resource.data.por == request.auth.uid;
    }
    // Ajustes por inversionista (días para pagarle, qué ve): solo el administrador.
    match /invcfg/{id} {
      allow read, write: if admin();
    }
    // Resumen que ve cada inversionista en su app: lo escribe el administrador, lo lee solo él.
    match /portafolio/{uid} {
      allow read: if admin() || (signed() && request.auth.uid == uid);
      allow write: if admin();
    }
    // Comprobantes de lo que se le paga a cada inversionista.
    match /recibos/{id} {
      allow read: if admin() || (signed() && resource.data.uid == request.auth.uid);
      allow write: if admin();
    }
    // Empresas con convenio: el administrador las maneja; la administradora de cada una solo lee la suya.
    match /empresas/{id} {
      allow read: if admin() || (emp() && miEmpresa() == id);
      allow write: if admin();
    }
    // Préstamos que ya existían: la administradora los propone, solo el administrador los confirma.
    match /altas/{id} {
      allow read: if admin() || (emp() && resource.data.empresa == miEmpresa());
      allow create: if emp() && request.resource.data.empresa == miEmpresa() && request.resource.data.por == request.auth.uid && request.resource.data.estado == 'pendiente';
      allow update, delete: if admin();
    }
    // Datos públicos del enlace de cada convenio (para la página del empleado). Solo se lee con el código exacto.
    match /convenios/{codigo} {
      allow get: if true;
      allow list, write: if admin();
    }
    // Contador anónimo de visitas de la página: cualquiera suma 1, solo el administrador lo lee.
    match /visitas/{dia} {
      allow read: if admin();
      allow create, update: if dia.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['total', 'personas', 'paginas', 'autos', 'wa'])
        && request.resource.data.get('total', 0) <= (resource == null ? 0 : resource.data.get('total', 0)) + 1
        && request.resource.data.get('personas', 0) <= (resource == null ? 0 : resource.data.get('personas', 0)) + 1
        && request.resource.data.get('wa', 0) <= (resource == null ? 0 : resource.data.get('wa', 0)) + 1
        && request.resource.data.get('paginas', {}).size() <= 20
        && request.resource.data.get('autos', {}).size() <= 300;
    }
    match /prestamos/{id} {
      allow read: if admin()
        || (team() && resource.data.por == request.auth.uid)
        || (signed() && resource.data.clienteUid == request.auth.uid)
        || (verified() && resource.data.clienteEmail == request.auth.token.email.lower())
        || (emp() && resource.data.get('empresa', '') != '' && resource.data.empresa == miEmpresa());
      allow create: if admin() || (team() && request.resource.data.por == request.auth.uid);
      allow update: if admin()
        || (team() && resource.data.por == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pagos', 'noPago', 'clienteEmail'])
            && (request.resource.data.get('pagos', []) == resource.data.get('pagos', [])
                || (request.resource.data.get('pagos', []).size() == resource.data.get('pagos', []).size() + 1
                    && request.resource.data.get('pagos', []).hasAll(resource.data.get('pagos', [])))))
        || (signed() && resource.data.get('clienteUid', '') == '' && request.resource.data.clienteUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clienteUid']));
      allow delete: if admin();
    }
  }
}
